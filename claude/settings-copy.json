{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "effortLevel": "high",
  "advisorModel": "fable",
  "tui": "fullscreen",
  "theme": "dark",
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/caffeinate-session.sh start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh \"Claude has a question in $(basename \"$PWD\")\""
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh \"Plan ready for review in $(basename \"$PWD\")\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh \"Permission required in $(basename \"$PWD\")\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh \"Task completed in $(basename \"$PWD\")\" \"/System/Library/Sounds/Glass.aiff\""
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/caffeinate-session.sh stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/caffeinate-session.sh stop"
          }
        ]
      }
    ]
  }
}
